{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lao-safe",
  "main": "dist/server/index.js",
  "assets": {
    "directory": "dist/client"
  },
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ]
}
